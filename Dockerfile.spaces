# ═══════════════════════════════════════════════════════════════════════════
# Intelli-Credit — Single-container Dockerfile for Hugging Face Spaces
# Serves both the FastAPI backend AND the built frontend via FastAPI static files
# ═══════════════════════════════════════════════════════════════════════════

# ── Stage 1: Build frontend ──────────────────────────────────────────────
FROM node:18-alpine AS frontend-build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit

COPY frontend/ .

# Build-time vars baked into the JS bundle
ENV VITE_API_URL=/api/v1
ENV VITE_API_KEY=dev-key-change-in-production
ARG VITE_SUPABASE_URL=https://oozjxnknjjohitpxpgbw.supabase.co
ARG VITE_SUPABASE_ANON_KEY=sb_publishable_yZo62RfqRDmuxWggxc4EtA_fXhbS9MM
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}

RUN npm run build

# ── Stage 2: Python backend + serve frontend static files ────────────────
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    curl \
    && curl --proto '=https' --tlsv1.2 -fsSL https://drop-sh.fullyjustified.net | sh \
    && mv /root/.cargo/bin/tectonic /usr/local/bin/tectonic || true \
    && rm -rf /var/lib/apt/lists/* /root/.cargo

WORKDIR /app

# Install CPU-only PyTorch first (saves ~1.5 GB vs full CUDA bundle)
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
# Install remaining deps (torch already satisfied, pip will skip it)
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ src/
COPY models/pipeline_models.py models/pipeline_models.py
COPY scripts/ scripts/
COPY tests/generate_training_data.py tests/generate_training_data.py
RUN touch tests/__init__.py
COPY run_api.py .
COPY .env.example .env.example

# Point HuggingFace / transformers at the in-image cache dir
ENV TRANSFORMERS_CACHE=/app/configs/model_cache
ENV HF_HOME=/app/configs/model_cache

# Create data directories BEFORE model training (GNN needs data/raw/gst/)
RUN mkdir -p data/raw/gst data/bronze data/silver data/gold outputs/cam_reports

# Download HuggingFace models + train bootstrap ML models at build time
# This bakes them into the image so startup is fast
ENV LOKY_MAX_CPU_COUNT=2
RUN python scripts/download_models.py

# Copy built frontend from stage 1
COPY --from=frontend-build /app/dist /app/frontend_dist

# HF Spaces requires port 7860
ENV PORT=7860
EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:7860/health || exit 1

CMD ["python", "run_api.py", "--workers", "1", "--log-level", "warning"]
