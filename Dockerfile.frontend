# ═══════════════════════════════════════════════════════════════════════════
# Intelli-Credit Frontend — Multi-stage Dockerfile
# Build with Node → Serve with nginx
# ═══════════════════════════════════════════════════════════════════════════

# ── Build stage ──────────────────────────────────────────────────────────
FROM node:18-alpine AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit

COPY frontend/ .

# In production the frontend talks to the backend through nginx reverse proxy
# so the base URL is relative, not absolute
ENV VITE_API_URL=/api/v1
ARG VITE_API_KEY=dev-key-change-in-production
ENV VITE_API_KEY=${VITE_API_KEY}

RUN npm run build

# ── Serve stage ──────────────────────────────────────────────────────────
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
