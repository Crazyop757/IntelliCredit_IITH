# ============================================================
# Intelli-Credit (FinSight) environment variables
# Copy to .env and fill in real values before running the API
# ============================================================

# ── API Security ─────────────────────────────────────────────
FINSIGHT_API_KEY=dev-key-change-in-production
FINSIGHT_DISABLE_AUTH=false

# ── Server ───────────────────────────────────────────────────
FINSIGHT_HOST=0.0.0.0
PORT=8000
FINSIGHT_DEBUG=false

# ── CORS (JSON list of allowed origins) ──────────────────────
# FINSIGHT_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# ── Supabase ─────────────────────────────────────────────────
FINSIGHT_SUPABASE_URL=https://your-project.supabase.co
FINSIGHT_SUPABASE_ANON_KEY=your-supabase-anon-key
FINSIGHT_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
FINSIGHT_SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── LLM / AI agent keys ─────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=your-tavily-api-key
SERPAPI_KEY=your-serpapi-key

# ── Databricks (optional — falls back to local parquet) ──────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
