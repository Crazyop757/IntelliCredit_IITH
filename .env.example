# ============================================================
# Intelli-Credit environment variables
# Copy to .env and fill in real values before running the API
# ============================================================

# ── API Security ─────────────────────────────────────────────
# Set a strong secret key in production
INTELLI_API_KEY=dev-key-change-in-production

# Set to true to bypass key check in trusted internal networks
INTELLI_DISABLE_AUTH=false

# ── Server ───────────────────────────────────────────────────
INTELLI_HOST=0.0.0.0
INTELLI_PORT=8000
INTELLI_DEBUG=false

# ── CORS (comma-separated origins) ───────────────────────────
# INTELLI_CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ── Paths ────────────────────────────────────────────────────
INTELLI_OUTPUTS_DIR=outputs
INTELLI_MODEL_PATH=models/gnn_fraud_detector.pt

# ── Anthropic (for Claude-backed LLM features) ───────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Workers ──────────────────────────────────────────────────
# Max concurrent pipeline threads
INTELLI_MAX_PIPELINE_WORKERS=4
