# IntelliCredit Frontend — Environment Variables

# Relative URL — requests are proxied by Vite dev server to avoid CORS (no browser restriction).
# The vite.config.ts proxy forwards /api/* -> http://localhost:8000/*
VITE_API_URL=/api/v1

# API key (must match FINSIGHT_API_KEY on the backend)
VITE_API_KEY=dev-key-change-in-production

# Supabase (public keys only — safe to embed in frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
