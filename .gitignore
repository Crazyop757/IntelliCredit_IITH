# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# ─── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Data lake ──────────────────────────────────────────────────────────────
# Keep directory structure but ignore generated data
data/raw/*
data/bronze/*
data/silver/*
data/gold/*
!data/raw/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep

# Common data formats
*.csv
*.parquet
*.xlsx
*.xls
*.db
*.sqlite

# Pipeline output files (JSONL can be large)
*.jsonl

# JSON data files everywhere EXCEPT raw seed/config files checked in intentionally
# (override with git add -f <file> if you want to commit a specific JSON)
data/**/*.json

# ─── Outputs (generated CAM docs, reports, etc.) ────────────────────────────
outputs/*
!outputs/.gitkeep

# ─── Environment / secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Keep the template
!.env.example

# ─── API runtime ─────────────────────────────────────────────────────────────
# uvicorn / gunicorn PID files
*.pid
# API key files
api_key.txt
secrets/

# ─── ML models & artifacts ──────────────────────────────────────────────────
# These can be hundreds of MB — store in DVC / object storage instead
models/
configs/model_cache/
*.safetensors
*.bin
*.pt
*.pth
*.ot
*.onnx
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5

# ─── IDEs ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db
desktop.ini

# ─── Testing & coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
nosetests.xml
test-results/

# ─── Linting / type-checking caches ─────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json

# ─── Logging ─────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Databricks ──────────────────────────────────────────────────────────────
.databricks/
databricks.yml

# ─── Config secrets ──────────────────────────────────────────────────────────
configs/secrets.*
configs/*.secret.*
*.DS_Store
desktop.ini
