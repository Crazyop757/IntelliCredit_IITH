# ═══════════════════════════════════════════════════════════════════════════
# Intelli-Credit .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# ─── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Data lake ──────────────────────────────────────────────────────────────
# Keep directory structure but ignore generated data
data/raw/*
data/bronze/*
data/silver/*
data/gold/*
data/iith_testing/*
!data/raw/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep

# Common data formats
*.csv
*.parquet
*.xlsx
*.xls
*.db
*.sqlite

# Pipeline output files (JSONL can be large)
*.jsonl

# JSON data files inside data/ (override with git add -f <file>)
data/**/*.json

# ─── Outputs (generated CAM docs, reports, etc.) ────────────────────────────
outputs/*
!outputs/.gitkeep

# ─── Environment / secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
# Keep the templates
!.env.example
frontend/.env
!frontend/.env.example

# ─── API runtime ─────────────────────────────────────────────────────────────
*.pid
api_key.txt
secrets/

# ─── ML models & artifacts ──────────────────────────────────────────────────
# Binary model weights — too large for git; use DVC / Git LFS / object storage
models/*.pt
models/*.pth
models/*.pkl
models/*.pickle
models/*.joblib
# Keep the Python source file
!models/pipeline_models.py

# HuggingFace model cache (hundreds of MB per model)
configs/model_cache/

# Generic ML binary formats
*.safetensors
*.bin
*.ot
*.onnx
*.npy
*.npz
*.h5
*.hdf5

# ─── Frontend ────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── Docker ──────────────────────────────────────────────────────────────────
docker-compose.override.yml
docker-compose.override.yaml

# ─── IDEs ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS files ────────────────────────────────────────────────────────────────
*.DS_Store
Thumbs.db
desktop.ini

# ─── Testing & coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
nosetests.xml
test-results/

# ─── Linting / type-checking caches ─────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json

# ─── Logging ─────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Databricks ──────────────────────────────────────────────────────────────
.databricks/
databricks.yml

# ─── Config secrets ──────────────────────────────────────────────────────────
configs/secrets.*
configs/*.secret.*
